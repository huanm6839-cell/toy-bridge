# Copy this file to .env and fill values learned from your device.
# Do not put guessed values here; the bridge refuses to send without a write UUID.

TOY_BLE_NAME=
TOY_BLE_ADDRESS=
TOY_WRITE_UUID=
# Leave blank to select a supported write mode automatically.
TOY_WRITE_WITH_RESPONSE=
TOY_SCAN_TIMEOUT=8
TOY_CONNECT_TIMEOUT=15
